<ul class="topics">
    @foreach (var topic in Topics)
    {
        <li>
            <a href="@topic.Path">@topic.Title</a>
            <span class="meta">@Labels.Of(topic.Level) · @Labels.Minutes(topic.Minutes)</span>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TopicEntry> Topics { get; set; } = [];
}

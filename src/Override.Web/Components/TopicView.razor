@*
    A lesson: one step at a time, with the steps bar on top and the page panel on the right.
    The step is part of the address (?step=2), so Back in the browser returns to the previous step.
*@
@implements IDisposable
@inject ProgressStore Progress
@inject ProfileStore Profile

<PageTitle>@Topic.Title · Override</PageTitle>

<div class="lesson">
    <article>
        <ol class="steps-bar" aria-label="Шаги урока">
            @for (var i = 0; i < Topic.Steps.Count; i++)
            {
                var index = i;
                <li class="@(index < _current ? "done" : null)">
                    <a href="@StepHref(index)"
                       aria-current="@(index == _current ? "step" : null)"
                       aria-label="@($"Шаг {index + 1}: {Labels.Of(Topic.Steps[index])}")"></a>
                </li>
            }
        </ol>
        <div class="step-caption">Шаг @(_current + 1) из @Topic.Steps.Count · <strong>@Labels.Of(CurrentStep)</strong></div>

        <h1>@Topic.Title</h1>
        <div class="meta">@Labels.Of(Topic.Level) · @Labels.MinutesLong(Topic.Minutes)</div>
        @if (!Profile.Shows(Topic.Level, Topic.Path))
        {
            <p class="level-note">Тема для уровня @Labels.Of(Topic.Level), это выше выбранного. Её можно читать, но на прогресс твоего уровня она не влияет.</p>
        }

        <section class="lesson-body">
            <h2>@Labels.Of(CurrentStep)</h2>

            @foreach (var block in CurrentStep.Blocks)
            {
                var level = Levels.Of(block);
                if (!_showAll && !Profile.Shows(level, Topic.Path))
                {
                    continue;
                }

                if (level is { } higher && higher > Topic.Level)
                {
                    <div class="level-block">
                        <span class="level-label">Глубже · @Labels.Of(higher)</span>
                        <PageBlockView @key="block" Block="block" TopicId="@Topic.Id" IsSummary="IsSummary" />
                    </div>
                }
                else
                {
                    <PageBlockView @key="block" Block="block" TopicId="@Topic.Id" IsSummary="IsSummary" />
                }
            }

            @if (!_showAll && CurrentStep.Blocks.Count > 0 && CurrentStep.Blocks.All(b => !Profile.Shows(Levels.Of(b), Topic.Path)))
            {
                <p class="level-note">Весь этот шаг — для уровня выше выбранного. Его можно открыть в правой панели или пропустить.</p>
            }
        </section>

        <nav class="lesson-nav" aria-label="Переход по шагам">
            @if (_current > 0)
            {
                <a class="button" href="@StepHref(_current - 1)">Назад</a>
            }
            @if (_current + 1 < Topic.Steps.Count)
            {
                <a class="button-primary" href="@StepHref(_current + 1)">Дальше: @Labels.Of(Topic.Steps[_current + 1])</a>
            }
            else if (_next is not null)
            {
                <a class="button-primary" href="@_next.Path">Следующая тема: @_next.Title</a>
            }
        </nav>
    </article>

    <aside class="page-aside" aria-label="О теме">
        <div class="page-aside-inner">
            <section class="panel-card">
                <div class="panel-title">На этой странице</div>
                <ol class="panel-list">
                    @for (var i = 0; i < Topic.Steps.Count; i++)
                    {
                        var index = i;
                        <li>
                            <a href="@StepHref(index)" aria-current="@(index == _current ? "step" : null)">@Labels.Of(Topic.Steps[index])</a>
                        </li>
                    }
                </ol>
            </section>

            <section class="panel-card">
                <div class="panel-title-row">
                    <span class="panel-title">Тема</span>
                    @if (_entry is not null)
                    {
                        <TopicStatusChip Status="Progress.StatusOf(_entry)" />
                    }
                </div>
                <div class="panel-facts">
                    <span>Уровень: @Labels.Of(Topic.Level)</span>
                    <span>Время: @Labels.MinutesLong(Topic.Minutes)</span>
                    @if (_entry is not null && Progress.QuestionsFor(_entry).Count is > 0 and var total)
                    {
                        <span>Верно с первой попытки: @Progress.KnownCount(_entry) из @total</span>
                    }
                </div>
            </section>

            @if (_entry is not null && Progress.QuestionsFor(_entry).Count > 0)
            {
                var strength = Progress.StrengthOf(_entry);
                var due = Progress.DueCount(_entry);
                var next = Progress.NextReview(_entry);

                <section class="panel-card">
                    <div class="panel-title-row">
                        <span class="panel-title">Сила темы</span>
                        <strong class="strength-value">@Labels.Percent(strength)</strong>
                    </div>
                    <div class="strength-bar" role="img" aria-label="@($"Сила темы {Labels.Percent(strength)}")">
                        <div style="@($"width: {Math.Round(strength * 100)}%")"></div>
                    </div>
                    <div class="panel-facts">
                        @if (due > 0)
                        {
                            <span>Повторить сегодня: @Labels.Questions(due)</span>
                        }
                        else if (next is { } date)
                        {
                            <span>Следующее повторение: @Labels.When(date, DateTimeOffset.Now)</span>
                        }
                        else
                        {
                            <span>Ответь на вопросы темы, и сайт спланирует повторение.</span>
                        }
                        @if (Progress.HasGaps(_entry))
                        {
                            <span class="gaps-note">Есть пробелы: на часть вопросов последний ответ был неверным или «не вспомнил».</span>
                        }
                    </div>
                </section>
            }

            @if (HiddenCount > 0 || _showAll)
            {
                <section class="panel-card">
                    <div class="panel-title">Для уровня выше</div>
                    <div class="panel-facts">
                        <span>@(_showAll ? "Показаны блоки всех уровней." : $"Скрыто блоков и вопросов: {HiddenCount}.")</span>
                    </div>
                    <button type="button" class="panel-button" @onclick="() => _showAll = !_showAll">@(_showAll ? "Скрыть лишнее" : "Показать всё")</button>
                </section>
            }

            @if (Topic.Requires.Count > 0)
            {
                <section class="panel-card">
                    <div class="panel-title">Нужно знать</div>
                    <ul class="panel-list">
                        @foreach (var id in Topic.Requires)
                        {
                            var required = Index.FindTopicById(id);
                            <li>
                                @if (required is not null)
                                {
                                    <a href="@required.Path">@required.Title</a>
                                }
                                else
                                {
                                    <span class="meta">@id · тема ещё пишется</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </aside>
</div>

@code {
    private int _current;
    private bool _showAll;
    private TopicEntry? _entry;
    private TopicEntry? _next;

    [Parameter, EditorRequired]
    public TopicPage Topic { get; set; } = default!;

    [Parameter, EditorRequired]
    public SiteIndex Index { get; set; } = default!;

    /// <summary>The step to show, counted from 1. Out of range values show the nearest step.</summary>
    [Parameter]
    public int Step { get; set; } = 1;

    private PageStep CurrentStep => Topic.Steps[_current];

    private bool IsSummary => CurrentStep.Kind == StepKind.Summary;

    /// <summary>Blocks and questions of the whole topic above the reader's level.</summary>
    private int HiddenCount => Topic.Steps.Sum(step => step.Blocks.Count(block => !Profile.Shows(Levels.Of(block), Topic.Path)));

    protected override void OnInitialized() => Progress.Changed += OnProgressChanged;

    protected override void OnParametersSet()
    {
        _current = Math.Clamp(Step - 1, 0, Topic.Steps.Count - 1);
        _entry = Index.FindTopicById(Topic.Id);
        _next = Index.NextTopic(Topic.Id);
        Progress.Visit(Topic.Id, _current);
    }

    private void OnProgressChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Progress.Changed -= OnProgressChanged;

    private string StepHref(int index) => index == 0 ? Topic.Path : $"{Topic.Path}?step={index + 1}";
}

@*
    A question in the text. The answer and the explanation stay hidden until the user answers.
    An answer is picked first and checked by a button, so a slip of the finger can be undone.
    Every check is saved; whether it was a first attempt is decided by the progress store.
*@
@inject ProgressStore Progress
@inject NavigationManager Navigation

<div class="question @StateClass">
    <div class="question-kind">Проверь себя · @Labels.Of(Quiz)</div>
    <div class="question-prompt">@((MarkupString)Quiz.Prompt)</div>

    @switch (Quiz)
    {
        case ChoiceQuiz choice:
            <CodeBlock Html="@Shown.CodeHtml" />
            <ul class="options">
                @foreach (var index in _optionOrder)
                {
                    <li>
                        <button type="button"
                                class="option @OptionClass(index, index == choice.Answer, _choice == index)"
                                disabled="@_answered"
                                aria-pressed="@(_choice == index ? "true" : "false")"
                                @onclick="() => _choice = index">
                            @((MarkupString)choice.Options[index])
                        </button>
                    </li>
                }
            </ul>
            if (!_answered)
            {
                <div class="question-actions">
                    <button type="button" class="button-check" disabled="@(_choice is null)" @onclick="() => Check(AnswerChecker.Check(choice, _choice!.Value))">@CheckLabel</button>
                </div>
            }
            break;

        case MultiQuiz multi:
            <CodeBlock Html="@Shown.CodeHtml" />
            <ul class="options">
                @foreach (var index in _optionOrder)
                {
                    <li>
                        <label class="option @OptionClass(index, multi.Answers.Contains(index), _selected.Contains(index))">
                            <input type="checkbox"
                                   checked="@_selected.Contains(index)"
                                   disabled="@_answered"
                                   @onchange="() => Toggle(index)" />
                            <span>@((MarkupString)multi.Options[index])</span>
                        </label>
                    </li>
                }
            </ul>
            if (!_answered)
            {
                <div class="question-actions">
                    <button type="button" class="button-check" disabled="@(_selected.Count == 0)" @onclick="() => Check(AnswerChecker.Check(multi, _selected))">@CheckLabel</button>
                </div>
            }
            break;

        case InputQuiz or OutputQuiz or FillQuiz:
            <CodeBlock Html="@Shown.CodeHtml" />
            <div class="answer-row">
                @if (IsMultiline)
                {
                    <textarea class="answer-input" rows="3" aria-label="Ваш ответ" placeholder="Ответ" disabled="@_answered" @bind="_text" @bind:event="oninput"></textarea>
                }
                else
                {
                    <input class="answer-input" type="text" aria-label="Ваш ответ" placeholder="Ответ" autocomplete="off" spellcheck="false"
                           disabled="@_answered" @bind="_text" @bind:event="oninput" @onkeydown="OnKeyDown" />
                }
                @if (!_answered)
                {
                    <button type="button" class="button-check" disabled="@string.IsNullOrWhiteSpace(_text)" @onclick="CheckText">@CheckLabel</button>
                }
            </div>
            break;

        case FindBugQuiz findBug:
            <ol class="code-lines" aria-label="Строки кода">
                @for (var i = 0; i < Lines.Count; i++)
                {
                    var line = i + 1;
                    <li>
                        <button type="button"
                                class="code-line @OptionClass(line, line == findBug.Line, _line == line)"
                                disabled="@_answered"
                                aria-label="@($"Строка {line}")"
                                aria-pressed="@(_line == line ? "true" : "false")"
                                @onclick="() => _line = line">
                            <span class="line-number" aria-hidden="true">@line</span>
                            <code>@((MarkupString)Lines[i])</code>
                        </button>
                    </li>
                }
            </ol>
            if (!_answered)
            {
                <div class="question-actions">
                    <button type="button" class="button-check" disabled="@(_line is null)" @onclick="() => Check(AnswerChecker.Check(findBug, _line!.Value))">@CheckLabel</button>
                </div>
            }
            break;

        case ParsonsQuiz parsons:
            <div class="parsons">
                <div class="parsons-label">Твой код</div>
                <ol class="parsons-answer" aria-label="Собранный код">
                    @if (_order.Count == 0)
                    {
                        <li class="parsons-empty">Нажимай на строки ниже по порядку</li>
                    }
                    @foreach (var item in _order)
                    {
                        var current = item;
                        <li>
                            <button type="button" class="parsons-line" disabled="@_answered" @onclick="() => Unpick(current)">
                                <code>@((MarkupString)Lines[current])</code>
                            </button>
                        </li>
                    }
                </ol>
                @if (!_answered)
                {
                    <div class="parsons-label">Строки</div>
                    <ul class="parsons-pool" aria-label="Доступные строки">
                        @foreach (var item in _pool.Where(i => !_order.Contains(i)))
                        {
                            var current = item;
                            <li>
                                <button type="button" class="parsons-line" @onclick="() => _order.Add(current)">
                                    <code>@((MarkupString)Lines[current])</code>
                                </button>
                            </li>
                        }
                    </ul>
                    <div class="question-actions">
                        <button type="button" class="button-check" disabled="@(_order.Count == 0)" @onclick="() => CheckParsons(parsons)">@CheckLabel</button>
                    </div>
                }
            </div>
            break;

        case RecallQuiz recall:
            <CodeBlock Html="@Shown.CodeHtml" />
            if (!_revealed)
            {
                <p class="question-hint">Ответь про себя или запиши, потом сравни с ответом.</p>
                <textarea class="answer-input" rows="3" aria-label="Мой ответ, не обязательно" placeholder="Мой ответ (не обязательно)" @bind="_text"></textarea>
                <div class="question-actions">
                    <button type="button" class="button-check" @onclick="() => _revealed = true">Показать ответ</button>
                </div>
            }
            else
            {
                <div class="@(IsSummary ? "summary-box" : "reference-box")">
                    <div class="reference-title">@(IsSummary ? "Кратко" : "Ответ")</div>
                    @((MarkupString)recall.Answer)
                </div>
                @* The buttons stay: a wrong press is corrected by pressing another one. *@
                <div class="question-actions self-check" role="group" aria-label="Насколько вспомнил">
                    <button type="button" class="button @AssessClass(Outcome.Forgot)" aria-pressed="@AssessPressed(Outcome.Forgot)" @onclick="() => Assess(Outcome.Forgot)">Не вспомнил</button>
                    <button type="button" class="button @AssessClass(Outcome.Partial)" aria-pressed="@AssessPressed(Outcome.Partial)" @onclick="() => Assess(Outcome.Partial)">Частично</button>
                    <button type="button" class="button @AssessClass(Outcome.Recalled)" aria-pressed="@AssessPressed(Outcome.Recalled)" @onclick="() => Assess(Outcome.Recalled)">Вспомнил</button>
                </div>
                if (_assessment is not null && _assessment != Outcome.Recalled)
                {
                    <p class="question-hint">Тема вернётся в повторение раньше.</p>
                }
            }
            break;

        case CodeQuiz or SqlQuiz:
            <CodeBlock Html="@Shown.CodeHtml" />
            <CodeTask TopicId="@TopicId" Quiz="Quiz" SolutionHtml="@Shown.SolutionHtml" OnAnswered="OnAnswered" />
            break;

        default:
            <CodeBlock Html="@Shown.CodeHtml" />
            break;
    }

    @if (_answered && HideFeedback)
    {
        <p class="question-hint" role="status">Ответ принят.</p>
    }
    else if (_answered)
    {
        <div class="feedback" role="status">
            <strong>@(_correct ? "Верно." : "Неверно.")</strong>
            @if (!_correct && CorrectAnswer is { } answer)
            {
                <span> Правильный ответ: <code>@answer</code></span>
            }
            @if (Quiz.Explain is not null)
            {
                <div class="feedback-explain">@((MarkupString)Quiz.Explain)</div>
            }
        </div>
        if (!_correct)
        {
            <div class="question-actions">
                <button type="button" class="button" @onclick="Reset">Попробовать ещё</button>
            </div>
        }
        <p class="report-link"><a href="@ReportUrl" target="_blank" rel="noopener">Неточность в вопросе?</a></p>
    }
</div>

@code {
    private bool _answered;
    private bool _correct;
    private int? _choice;
    private int? _line;
    private string _text = "";
    private bool _revealed;
    private Outcome? _assessment;
    private readonly HashSet<int> _selected = [];
    private readonly List<int> _order = [];
    private List<int> _pool = [];

    [Parameter, EditorRequired]
    public string TopicId { get; set; } = "";

    [Parameter, EditorRequired]
    public QuestionBlock Question { get; set; } = default!;

    /// <summary>
    /// Whether the card chooses a version of the question itself. A test turns it off: it picks the versions
    /// up front, to show the same ones in the results.
    /// </summary>
    [Parameter]
    public bool PickVariant { get; set; } = true;

    [Parameter]
    public bool IsSummary { get; set; }

    /// <summary>In a test the answer is taken without showing whether it was right; results come at the end.</summary>
    [Parameter]
    public bool HideFeedback { get; set; }

    /// <summary>Called after each answer or self-assessment, with how it ended and whether it was a first attempt.</summary>
    [Parameter]
    public EventCallback<AnswerResult> OnAnswered { get; set; }

    private QuestionBlock? _source;
    private QuestionBlock _shown = default!;

    /// <summary>Options in the order shown: shuffled, so that the answer is not remembered by its place.</summary>
    private List<int> _optionOrder = [];

    /// <summary>The version of the question on screen: the question itself or one of its variants.</summary>
    private QuestionBlock Shown => _shown;

    private Quiz Quiz => _shown.Quiz;

    private string ReportUrl => Feedback.Issue(
        $"Неточность в вопросе {Quiz.Id}",
        $"Тема: {TopicId}\nВопрос: {Quiz.Id}\nВариант: {VariantNumber}\nАдрес: {Navigation.Uri}");

    /// <summary>1 for the question as written, 2 and on for its variants in file order.</summary>
    private int VariantNumber => Question.Variants?.ToList().IndexOf(_shown) + 2 ?? 1;

    private IReadOnlyList<string> Lines => _shown.LinesHtml ?? [];

    private bool IsMultiline => Quiz is OutputQuiz output && output.Answers.Any(a => a.Trim().Contains('\n'));

    /// <summary>In a test the answer is only taken, not checked.</summary>
    private string CheckLabel => HideFeedback ? "Ответить" : "Проверить";

    private string? AssessClass(Outcome outcome) => _assessment == outcome ? "is-picked" : null;

    private string AssessPressed(Outcome outcome) => _assessment == outcome ? "true" : "false";

    private string StateClass => !_answered || HideFeedback ? "" : _correct ? "is-correct" : "is-wrong";

    /// <summary>The expected typed answer, shown after a wrong attempt. Other question types show it by marking.</summary>
    private string? CorrectAnswer => Quiz switch
    {
        InputQuiz input => input.Answers[0],
        OutputQuiz output => output.Answers[0],
        FillQuiz fill => fill.Answers[0],
        _ => null,
    };

    /// <summary>A new question gets a version and a fresh order of options; a redraw of the same one keeps them.</summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_source, Question))
            return;

        _source = Question;
        _shown = PickVariant ? Progress.PickVariant(TopicId, Question) : Question;
        Reset();
        _revealed = false;
        _assessment = null;

        var options = Quiz switch
        {
            ChoiceQuiz choice => choice.Options.Count,
            MultiQuiz multi => multi.Options.Count,
            _ => 0,
        };
        _optionOrder = Shuffled(options, allowSame: true);
        _pool = Quiz is ParsonsQuiz ? Shuffled(Lines.Count) : [];
    }

    private void Toggle(int option)
    {
        if (!_selected.Remove(option))
            _selected.Add(option);
    }

    private void Unpick(int item) => _order.Remove(item);

    private void CheckText()
    {
        if (string.IsNullOrWhiteSpace(_text))
            return;

        var correct = Quiz switch
        {
            InputQuiz input => AnswerChecker.Check(input, _text),
            OutputQuiz output => AnswerChecker.Check(output, _text),
            FillQuiz fill => AnswerChecker.Check(fill, _text),
            _ => false,
        };
        Check(correct);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_answered)
            CheckText();
    }

    private void CheckParsons(ParsonsQuiz quiz)
    {
        var lines = quiz.Lines.Concat(quiz.Distractors).ToList();
        Check(AnswerChecker.Check(quiz, _order.Select(i => lines[i])));
    }

    private void Check(bool correct)
    {
        _answered = true;
        _correct = correct;
        var outcome = correct ? Outcome.Correct : Outcome.Wrong;
        var first = Progress.Record(TopicId, Quiz.Id, outcome);
        _ = OnAnswered.InvokeAsync(new AnswerResult(outcome, first, Given()));
    }

    /// <summary>The answer as given, for the results of a test.</summary>
    private GivenAnswer Given() => Quiz switch
    {
        ChoiceQuiz => new GivenAnswer(Options: _choice is { } choice ? [choice] : []),
        MultiQuiz => new GivenAnswer(Options: [.. _selected.Order()]),
        FindBugQuiz => new GivenAnswer(Line: _line),
        ParsonsQuiz => new GivenAnswer(Order: [.. _order]),
        _ => new GivenAnswer(Text: _text),
    };

    /// <summary>
    /// "Recalled" is saved but never counts as knowledge: the user's own estimate can be too kind.
    /// A second press changes the saved estimate instead of adding another attempt.
    /// </summary>
    private void Assess(Outcome outcome)
    {
        if (_assessment == outcome)
            return;

        if (_assessment is not null)
        {
            _assessment = outcome;
            Progress.Amend(TopicId, Quiz.Id, outcome);
            return;
        }

        _assessment = outcome;
        var first = Progress.Record(TopicId, Quiz.Id, outcome);
        _ = OnAnswered.InvokeAsync(new AnswerResult(outcome, first));
    }

    private void Reset()
    {
        _answered = false;
        _correct = false;
        _choice = null;
        _line = null;
        _text = "";
        _selected.Clear();
        _order.Clear();
    }

    /// <summary>Marks options after the answer: the right one, and the user's pick if it was wrong.</summary>
    private string OptionClass(int option, bool isRight, bool isPicked)
    {
        if (!_answered || HideFeedback)
            return isPicked ? "is-picked" : "";

        if (isRight)
            return "is-right";

        return isPicked ? "is-mistake" : "is-dimmed";
    }

    /// <summary>
    /// A random order. For parsons it must differ from the right one, or the task would be solved in advance;
    /// options may stay in place by chance.
    /// </summary>
    private static List<int> Shuffled(int count, bool allowSame = false)
    {
        var items = Enumerable.Range(0, count).ToList();
        if (count < 2)
            return items;

        do
        {
            items = [.. items.OrderBy(_ => Random.Shared.Next())];
        }
        while (!allowSame && items.SequenceEqual(Enumerable.Range(0, count)));

        return items;
    }
}

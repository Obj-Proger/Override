@*
    A task to write code. C# runs in the browser against the task's tests; the first run downloads the compiler.
    A passed or failed run is saved like any answer; code that does not compile is not counted.
*@
@inject CodeRunService Runner
@inject SqlRunService Sql
@inject ProgressStore Progress

<CodeEditor @ref="_editor" InitialText="@Starter" Language="@Language" />

<div class="question-actions">
    @if (CanRun)
    {
        <button type="button" class="button-check" disabled="@_running" @onclick="RunAsync">
            @RunLabel
        </button>
    }
    <button type="button" class="button" @onclick="ResetAsync">Сбросить</button>
    <button type="button" class="button" @onclick="() => _showSolution = !_showSolution">@(_showSolution ? "Скрыть решение" : "Показать решение")</button>
</div>

@if (!CanRun)
{
    <p class="question-hint">Запуск таких заданий прямо на странице скоро появится. Пока можно написать решение и сравнить его с эталоном.</p>
}
else if (_first && _result is null && !_running)
{
    <p class="question-hint">@(IsSql ? "Первый запуск загрузит PostgreSQL" : "Первый запуск загрузит компилятор C#"), это несколько мегабайт и несколько секунд.</p>
}

@if (_result is not null)
{
    <div class="run-result @ResultClass" role="status">
        <strong>@ResultTitle</strong>
        @if (_result.Messages.Count > 0)
        {
            <ul class="run-messages">
                @foreach (var message in _result.Messages)
                {
                    <li>@message</li>
                }
            </ul>
        }
        @if (_table is not null)
        {
            <SqlResultTable Table="_table" />
        }
        @if (!string.IsNullOrEmpty(_result.Output))
        {
            <div class="run-output-title">Вывод</div>
            <pre class="run-output">@_result.Output</pre>
        }
        @if (_result.Status == CodeRunStatus.Passed && Quiz.Explain is not null)
        {
            <div class="feedback-explain">@((MarkupString)Quiz.Explain)</div>
        }
    </div>
}

@if (_error is not null)
{
    <p class="gaps-note" role="alert">@_error</p>
}

@if (_showSolution)
{
    <div class="reference-box">
        <div class="reference-title">Решение</div>
        @if (SolutionHtml is not null)
        {
            <text>@((MarkupString)SolutionHtml)</text>
        }
        else
        {
            <pre class="code"><code>@Solution</code></pre>
        }
    </div>
}

@code {
    private CodeEditor? _editor;
    private bool _showSolution;
    private bool _running;
    private bool _first = true;
    private CodeRunResult? _result;
    private SqlTable? _table;
    private string? _error;

    [Parameter, EditorRequired]
    public string TopicId { get; set; } = "";

    [Parameter, EditorRequired]
    public Quiz Quiz { get; set; } = default!;

    /// <summary>The reference solution highlighted by the build.</summary>
    [Parameter]
    public string? SolutionHtml { get; set; }

    /// <summary>Called after a counted run, like an answer to any other question.</summary>
    [Parameter]
    public EventCallback<AnswerResult> OnAnswered { get; set; }

    private bool CanRun => Quiz is CodeQuiz { Language: "csharp" } or SqlQuiz;

    private bool IsSql => Quiz is SqlQuiz;

    private string RunLabel => !_running
        ? (IsSql ? "Выполнить запрос" : "Запустить проверки")
        : IsSql
            ? (Sql.IsLoaded ? "Выполняем…" : "Загружаем PostgreSQL…")
            : (Runner.IsLoaded ? "Проверяем…" : "Загружаем компилятор…");

    private string Starter => Quiz switch
    {
        CodeQuiz code => code.Starter,
        _ => "",
    };

    private string Solution => Quiz switch
    {
        CodeQuiz code => code.Solution,
        SqlQuiz query => query.Solution,
        _ => "",
    };

    private string Language => Quiz switch
    {
        CodeQuiz code => code.Language,
        _ => "sql",
    };

    private string ResultTitle => _result!.Status switch
    {
        CodeRunStatus.Passed => IsSql ? "Результат совпадает с ожидаемым." : "Все проверки пройдены.",
        CodeRunStatus.Failed => IsSql ? "Результат не совпадает с ожидаемым." : "Проверка не пройдена.",
        CodeRunStatus.CompileError => IsSql ? "Запрос не выполнился." : "Код не компилируется.",
        CodeRunStatus.Stopped => "Выполнение остановлено.",
        _ => "Во время выполнения возникло исключение.",
    };

    private string ResultClass => _result!.Status switch
    {
        CodeRunStatus.Passed => "is-passed",
        CodeRunStatus.CompileError => "is-neutral",
        _ => "is-failed",
    };

    private async Task RunAsync()
    {
        if (_editor is null || !CanRun)
            return;

        _running = true;
        _error = null;

        try
        {
            var code = await _editor.GetTextAsync();
            (CodeRunResult? Result, SqlTable? Table) run = Quiz switch
            {
                SqlQuiz query => ToResult(await Sql.RunAsync(query, code)),
                CodeQuiz task => (await Runner.RunTestsAsync(code, task.Tests), null),
                _ => (null, null),
            };
            (_result, _table) = run;
            _first = false;
            if (_result is null)
                return;

            // Typos are not mistakes in understanding: code that does not compile, or a query that fails,
            // is not counted.
            if (_result.Status != CodeRunStatus.CompileError)
            {
                var outcome = _result.Status == CodeRunStatus.Passed ? Outcome.Correct : Outcome.Wrong;
                var first = Progress.Record(TopicId, Quiz.Id, outcome);
                await OnAnswered.InvokeAsync(new AnswerResult(outcome, first));
            }
        }
        catch (Exception exception)
        {
            _error = $"Не удалось запустить код: {exception.Message}";
        }
        finally
        {
            _running = false;
        }
    }

    /// <summary>A query that fails counts like code that does not compile: it is shown, not graded.</summary>
    private static (CodeRunResult, SqlTable?) ToResult(SqlRunResult result)
    {
        var status = !result.Executed ? CodeRunStatus.CompileError : result.Matches ? CodeRunStatus.Passed : CodeRunStatus.Failed;
        string[] messages = result.Message is null ? [] : [result.Message];
        return (new CodeRunResult(status, messages, ""), result.Table);
    }

    private async Task ResetAsync()
    {
        if (_editor is not null)
            await _editor.SetTextAsync(Starter);
    }
}

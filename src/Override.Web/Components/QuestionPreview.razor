@* Temporary: shows the question without answering. Interactive questions come later. *@
<div class="question">
    <div class="question-prompt">@((MarkupString)Quiz.Prompt)</div>

    @if (CodeHtml is not null)
    {
        <text>@((MarkupString)CodeHtml)</text>
    }

    @switch (Quiz)
    {
        case ChoiceQuiz choice:
            <ol class="options">
                @foreach (var option in choice.Options)
                {
                    <li>@((MarkupString)option)</li>
                }
            </ol>
            break;
        case MultiQuiz multi:
            <ol class="options">
                @foreach (var option in multi.Options)
                {
                    <li>@((MarkupString)option)</li>
                }
            </ol>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Quiz Quiz { get; set; } = default!;

    /// <summary>The highlighted code of the question, if it has code.</summary>
    [Parameter]
    public string? CodeHtml { get; set; }
}

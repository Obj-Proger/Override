@page "/"
@inject ContentClient Content

<PageTitle>Override</PageTitle>

<div class="catalog">
    <h1>Override</h1>
    <p class="catalog-lead">Короткие объяснения на примерах кода, с рисунками и вопросами прямо в тексте. Прогресс хранится только в этом браузере, а на другое устройство переносится ссылкой.</p>
    <p class="chooser-hint"><a href="diagnostic">Проверить уровень диагностикой</a> · <a href="skills">Карточка навыков</a> · <a href="transfer">Перенести прогресс</a></p>

    @if (_index is null)
    {
        <p class="loading" role="status">Загрузка…</p>
    }
    else
    {
        <TodayPanel Index="_index" />

        foreach (var stack in _index.Sections)
        {
            <section class="catalog-group">
                <h2>@stack.Title</h2>
                <div class="catalog-cards">
                    @foreach (var technology in stack.Sections)
                    {
                        <a class="catalog-card" href="@technology.Path">
                            <span class="catalog-card-title">@technology.Title</span>
                            <span class="catalog-card-meta">@Labels.Topics(technology.TopicsIn().Count())</span>
                        </a>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private SiteIndex? _index;

    protected override async Task OnInitializedAsync() => _index = await Content.GetIndexAsync();
}

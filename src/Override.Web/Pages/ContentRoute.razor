@page "/{*Path}"
@inject ContentClient Content

@if (_index is null || _loading)
{
    <p class="loading" role="status">Загрузка…</p>
}
else if (_topic is not null)
{
    <TopicView Topic="_topic" Index="_index" Step="Step ?? 1" />
}
else if (_section is not null)
{
    <SectionPage Section="_section" />
}
else
{
    <NotFound />
}

@code {
    private SiteIndex? _index;
    private bool _loading = true;
    private TopicPage? _topic;
    private SectionEntry? _section;

    /// <summary>The address after the base path, e.g. dotnet/csharp/type-system/boxing.</summary>
    [Parameter]
    public string? Path { get; set; }

    /// <summary>The lesson step from ?step=, counted from 1.</summary>
    [SupplyParameterFromQuery(Name = "step")]
    public int? Step { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var path = (Path ?? "").Trim('/');

        // Moving between steps of the same topic changes only the query: nothing to load.
        if (_topic?.Path == path)
            return;

        _loading = true;
        _topic = null;
        _section = null;

        _index = await Content.GetIndexAsync();
        if (_index.FindTopic(path) is { } topic)
            _topic = await Content.GetTopicAsync(topic.Id);
        else
            _section = _index.FindSection(path);

        _loading = false;
    }
}

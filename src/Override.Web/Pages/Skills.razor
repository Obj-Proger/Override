@page "/skills"
@implements IDisposable
@inject ContentClient Content
@inject SkillCard Card
@inject ProgressStore Progress
@inject IJSRuntime JS

<PageTitle>Карточка навыков · Override</PageTitle>

<div class="catalog skills">
    <h1>Карточка навыков</h1>
    <p class="catalog-lead">Что пройдено, насколько прочно и где пробелы — вплоть до вопросов с ошибками. Сводку можно скопировать текстом, например чтобы спланировать, что учить дальше, вместе с помощником.</p>

    @if (_stacks is null)
    {
        <p class="loading" role="status">Загрузка…</p>
    }
    else
    {
        <div class="skills-actions">
            <button type="button" class="button-check" @onclick="CopyAsync">Скопировать сводку</button>
            @if (_copyMessage is not null)
            {
                <span class="meta" role="status">@_copyMessage</span>
            }
        </div>

        foreach (var stack in _stacks)
        {
            <section class="catalog-group">
                <h2>@stack.Stack.Title <span class="level-tag">@Labels.Of(stack.Level)</span></h2>
                @foreach (var section in stack.Sections)
                {
                    <h3 class="skills-section">@section.Title</h3>
                    <ul class="topic-rows">
                        @foreach (var topic in section.Topics)
                        {
                            <li class="skill-item">
                                <a class="topic-row skill-row" href="@topic.Topic.Path">
                                    <span class="topic-row-title">@topic.Topic.Title</span>
                                    <span class="skill-facts">
                                        <span class="meta">@SkillCard.StatusText(topic.Status)</span>
                                        @if (topic.Status != TopicStatus.NotStarted)
                                        {
                                            <span class="strength-bar skill-bar" role="img" aria-label="@($"Сила {Labels.Percent(topic.Strength)}")">
                                                <span style="@($"width: {Math.Round(topic.Strength * 100)}%")"></span>
                                            </span>
                                        }
                                        @if (topic.HasGaps)
                                        {
                                            <span class="gaps-note">пробелы</span>
                                        }
                                        @if (topic.BestTest is { } test)
                                        {
                                            <span class="meta">тест @Labels.Percent(test.Share)</span>
                                        }
                                    </span>
                                </a>
                                @if (topic.Answered > 0)
                                {
                                    <details class="skill-details" open="@(topic.Mistakes.Any(m => !m.Fixed))">
                                        <summary>
                                            Отвечено вопросов: @topic.Answered, с ошибками: @topic.Mistakes.Count
                                            @if (topic.Mistakes.Count(m => !m.Fixed) is > 0 and var open)
                                            {
                                                <span class="gaps-note"> · не исправлено: @open</span>
                                            }
                                        </summary>
                                        @if (topic.Mistakes.Count == 0)
                                        {
                                            <p class="meta">Ошибок не было.</p>
                                        }
                                        <ul class="skill-mistakes">
                                            @foreach (var mistake in topic.Mistakes)
                                            {
                                                <li class="@(mistake.Fixed ? "is-fixed" : "is-open")">
                                                    <div class="skill-mistake-head">
                                                        <span class="skill-mistake-state">@(mistake.Fixed ? "исправлено" : "не исправлено")</span>
                                                        <span class="meta">@SkillCard.StatText(mistake.Stat)</span>
                                                    </div>
                                                    <div class="question-prompt">@((MarkupString)mistake.PromptHtml)</div>
                                                    <CodeBlock Html="@mistake.CodeHtml" />
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    }
</div>

@code {
    private SiteIndex? _index;

    /// <summary>Pages of topics with answers: the card shows the text of the questions with mistakes.</summary>
    private readonly Dictionary<string, TopicPage> _pages = [];
    private IReadOnlyList<SkillStack>? _stacks;
    private string? _copyMessage;

    protected override async Task OnInitializedAsync()
    {
        Progress.Changed += OnProgressChanged;
        _index = await Content.GetIndexAsync();
        await LoadPagesAsync();
        _stacks = Card.Build(_index, _pages);
    }

    private async Task LoadPagesAsync()
    {
        foreach (var topic in _index!.AllTopics().Where(Progress.HasAnswers))
        {
            if (!_pages.ContainsKey(topic.Id))
                _pages[topic.Id] = await Content.GetTopicAsync(topic.Id);
        }
    }

    private async Task CopyAsync()
    {
        if (_stacks is null)
            return;

        var copied = await JS.InvokeAsync<bool>("overrideClipboard.copy", Card.ToMarkdown(_stacks, DateTimeOffset.Now));
        _copyMessage = copied ? "Скопировано." : "Браузер не разрешил копирование.";
    }

    private void OnProgressChanged()
    {
        if (_index is null)
            return;

        _stacks = Card.Build(_index, _pages);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Progress.Changed -= OnProgressChanged;
}

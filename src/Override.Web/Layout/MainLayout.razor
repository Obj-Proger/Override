@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject ContentClient Content
@inject IJSRuntime JS
@inject ProfileStore Profile
@inject ProgressStore Progress
@inject Coach Coach

<a class="skip-link" href="@SkipHref">К содержанию</a>

<header class="topbar">
    <button type="button"
            class="icon-button menu-button"
            aria-label="Программа"
            aria-controls="program"
            aria-expanded="@(_menuOpen ? "true" : "false")"
            @onclick="ToggleMenu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
    <a class="brand" href="">Override</a>

    @if (_trail.Count > 0)
    {
        <nav class="trail" aria-label="Путь">
            @for (var i = 0; i < _trail.Count; i++)
            {
                var section = _trail[i];
                if (i > 0)
                {
                    <span aria-hidden="true">›</span>
                }

                if (section.Path == _path)
                {
                    <span aria-current="page">@section.Title</span>
                }
                else
                {
                    <a href="@section.Path">@section.Title</a>
                }
            }
        </nav>
    }

    <div class="topbar-spacer"></div>
    <button type="button" class="search-button" aria-label="Поиск по сайту" title="Поиск (Ctrl K)" @onclick="OpenSearch">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        <span class="search-button-text">Поиск</span>
        <kbd>Ctrl K</kbd>
    </button>
    @if (_dueCount > 0)
    {
        <a class="review-link" href="review" title="Вопросы на повторение сегодня">Повторить <strong>@_dueCount</strong></a>
    }
    @if (Profile.Profile is { } profile)
    {
        @* The level shown is the one for the current page: a stack can have its own. *@
        <button type="button" class="profile-button" aria-haspopup="dialog" title="Уровень и направление" @onclick="() => _profileOpen = true">
            @Labels.Of(Profile.LevelFor(_path))<span class="profile-track"> · @Labels.Of(profile.Track)</span>
        </button>
    }
    <ThemeToggle />
</header>

<div class="frame @(_menuOpen ? "menu-open" : null)">
    <aside class="sidebar" id="program" aria-label="Программа">
        <div class="sidebar-inner">
            @if (_index is not null)
            {
                <ProgramNav Index="_index" Path="@_path" />
            }
        </div>
    </aside>
    <button type="button" class="sidebar-backdrop" aria-label="Закрыть программу" tabindex="-1" @onclick="CloseMenu"></button>

    <main class="page" id="content" tabindex="-1" @ref="_main">
        @if (Profile.Profile is null && _path != DiagnosticPath)
        {
            <div class="catalog">
                <ProfileChooser Stacks="Stacks" OnSave="SaveProfile" />
            </div>
        }
        else
        {
            <text>@Body</text>
        }
    </main>
</div>

@if (_searchOpen)
{
    <SearchDialog OnClose="CloseSearch" />
}

@if (_profileOpen)
{
    <div class="dialog-backdrop" @onclick="CloseProfile"></div>
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title">
        <ProfileChooser Initial="Profile.Profile" Stacks="Stacks" OnSave="SaveProfile" OnCancel="CloseProfile" />
    </div>
}

@code {
    private SiteIndex? _index;
    private string _path = "";
    private IReadOnlyList<SectionEntry> _trail = [];
    private bool _menuOpen;
    private bool _scrollToTop;
    private bool _focusMain;
    private ElementReference _main;
    private bool _profileOpen;
    private bool _searchOpen;
    private int _dueCount;
    private DotNetObjectReference<MainLayout>? _self;

    /// <summary>The diagnostic opens before the level is chosen: it is a way to choose it.</summary>
    private const string DiagnosticPath = "diagnostic";

    private IReadOnlyList<SectionEntry> Stacks => _index?.Sections ?? [];

    /// <summary>The skip link keeps the query, so a lesson step stays the same.</summary>
    private string SkipHref => Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0] + "#content";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _path = PagePath.Of(Navigation);
        Progress.Changed += OnProgressChanged;
        _index = await Content.GetIndexAsync();
        _trail = _index.Trail(_path);
        _dueCount = Coach.PlanReview(_index).TotalDue;
    }

    private void OnProgressChanged()
    {
        if (_index is null)
            return;

        _dueCount = Coach.PlanReview(_index).TotalDue;
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _path = PagePath.Of(Navigation);
        _trail = _index?.Trail(_path) ?? [];
        _menuOpen = false;
        _profileOpen = false;
        _searchOpen = false;
        _scrollToTop = true;
        _focusMain = true;
        StateHasChanged();
    }

    /// <summary>
    /// A new page or a new lesson step starts at the top. The browser does not do it by itself when
    /// only the query changes, as with ?step=.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("overrideShortcuts.register", _self);
        }

        if (_scrollToTop)
        {
            _scrollToTop = false;
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }

        // After a link the keyboard continues from the new page, not from the link that is gone.
        if (_focusMain)
        {
            _focusMain = false;
            await JS.InvokeVoidAsync("overrideShortcuts.focusQuietly", _main);
        }
    }

    private void SaveProfile(LearnerProfile profile)
    {
        Profile.Set(profile);
        _profileOpen = false;
    }

    private void CloseProfile() => _profileOpen = false;

    /// <summary>Called from the button and from the Ctrl+K and "/" shortcuts.</summary>
    [JSInvokable]
    public void OpenSearch()
    {
        _searchOpen = true;
        StateHasChanged();
    }

    private void CloseSearch() => _searchOpen = false;

    /// <summary>Escape closes whatever is open on top of the page: a dialog or the program drawer.</summary>
    [JSInvokable]
    public void CloseOverlays()
    {
        if (!_searchOpen && !_profileOpen && !_menuOpen)
            return;

        _searchOpen = false;
        _profileOpen = false;
        _menuOpen = false;
        StateHasChanged();
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Progress.Changed -= OnProgressChanged;
        _self?.Dispose();
    }
}
